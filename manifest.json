{
  "manifest_version": 3,
  "name": "Edita Tools Side Panel",
  "version": "1.3.2",
  "description": "edita.tools is one of the most powerful website-only tool for your daily life.",
  "icons": {
    "16": "icon/logo-rounded.png",
    "48": "icon/logo-rounded.png",
    "128": "icon/logo-rounded.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "windows",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Edita Tools",
    "default_icon": {
      "16": "icon/logo-rounded.png",
      "32": "icon/logo-rounded.png",
      "48": "icon/logo-rounded.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.css",
        "tools/qr.html",
        "tools/youtube-thumbnail.html",
        "tools/youtube-playlist-analyzer.html",
        "tools/uuid-generator.html",
        "tools/fml-converter.html",
        "tools/base-converter.html",
        "tools/color-converter.html",
        "tools/calculator.html",
        "tools/integration-tool.html",
        "tools/differentiation-tool.html",
        "tools/logarithm-tool.html",
        "tools/roll-dice.html",
        "tools/coin-flip.html",
        "tools/spin-the-wheel.html",
        "tools/typing-speed-test.html",
        "tools/mouse-accuracy-checker.html",
        "tools/sip-calculator.html",
        "tools/json-formatter.html",
        "tools/json-to-excel.html",
        "tools/markdown-to-docx.html",
        "tools/markdown-to-excel.html",
        "tools/csv-to-json.html",
        "tools/json-to-csv.html",
        "tools/unit-converter.html",
        "tools/temperature-converter.html",
        "tools/regex-tester.html",
        "tools/image-cropper.html",
        "tools/password-generator.html",
        "tools/stopwatch-timer.html",
        "tools/time-zone-matcher.html",
        "tools/metadata-stripper-guide.html",
        "tools/tool-base.css",
        "tools/qr.js",
        "tools/youtube-thumbnail.js",
        "tools/youtube-playlist-analyzer.js",
        "tools/uuid-generator.js",
        "tools/fml-converter.js",
        "tools/base-converter.js",
        "tools/color-converter.js",
        "tools/calculator.js",
        "tools/math-expression-utils.js",
        "tools/integration-tool.js",
        "tools/differentiation-tool.js",
        "tools/logarithm-tool.js",
        "tools/roll-dice.js",
        "tools/coin-flip.js",
        "tools/spin-the-wheel.js",
        "tools/typing-speed-test.js",
        "tools/mouse-accuracy-checker.js",
        "tools/sip-calculator.js",
        "tools/json-formatter.js",
        "tools/json-to-excel.js",
        "tools/markdown-to-docx.js",
        "tools/markdown-to-excel.js",
        "tools/csv-to-json.js",
        "tools/json-to-csv.js",
        "tools/unit-converter.js",
        "tools/temperature-converter.js",
        "tools/regex-tester.js",
        "tools/image-cropper.js",
        "tools/password-generator.js",
        "tools/stopwatch-timer.js",
        "tools/time-zone-matcher.js",
        "tools/metadata-stripper-guide.js",
        "tools/tool-base-footer.js",
        "icon/logo-icon.png",
        "libs/qrcode.min.js",
        "scripts/sidepanel/close-panel.js",
        "scripts/sidepanel/tool-links.js",
        "scripts/content/panel-overlay.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}